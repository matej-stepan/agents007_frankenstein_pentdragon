{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taltempla/manifest.schema.json",
  "title": "Taltempla tool manifest",
  "type": "object",
  "required": ["name", "grade", "summary", "description", "keywords", "input_schema", "output_schema",
               "uses", "deps", "permissions", "limits", "examples"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
    "version": {"type": "integer", "minimum": 1, "description": "Set by shedd at register."},
    "parent": {"type": ["string", "null"], "description": "name@vN of the version this one repairs or extends."},
    "grade": {"enum": ["big", "small"], "description": "big = composed of small tools (uses non-empty), task level. small = generic, reusable."},
    "summary": {"type": "string", "maxLength": 120},
    "description": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "input_schema": {"type": "object", "description": "JSON Schema of args."},
    "output_schema": {"type": "object", "description": "JSON Schema of the result. Big tools: {results, warnings, sources}."},
    "uses": {"type": "array", "items": {"type": "string"}, "description": "Tools this tool may shed.call(). Literal names only."},
    "deps": {"type": "array", "items": {"type": "string"}, "description": "Package names from toolshed/packages.json."},
    "permissions": {
      "type": "object",
      "required": ["network", "llm_usd", "files"],
      "additionalProperties": false,
      "properties": {
        "network": {"type": "boolean"},
        "llm_usd": {"type": "number", "minimum": 0, "maximum": 0.25, "description": "Max USD of shed.llm per root run. 0 = no LLM."},
        "files": {"enum": ["none", "read", "write"], "description": "Access to /work."}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 180},
        "memory_mb": {"type": "integer", "minimum": 128, "maximum": 4096}
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["args"],
        "properties": {"args": {"type": "object"}, "note": {"type": "string"}}
      }
    }
  }
}
